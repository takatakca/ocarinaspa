# ============================================================
# Ocarina Spa Québec — production environment
# Copy to .env locally or configure in the host's secret manager.
# NEVER commit real secret values.
# ============================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PUBLIC_SITE_URL=https://ocarinaspa.ca

# Supabase — server only where marked
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY

# Browser/build-time Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Backend AI gateway — SERVER ONLY
LOVABLE_API_KEY=

# Google Maps browser key — public but restrict by HTTP referrer to ocarinaspa.ca
VITE_GOOGLE_MAPS_API_KEY=

# Stripe invoicing
STRIPE_SECRET_KEY=                    # SERVER ONLY: sk_test_... / sk_live_...
STRIPE_WEBHOOK_SECRET=                # SERVER ONLY: whsec_...
STRIPE_ACCOUNT_ID=                    # Expected acct_... checkpoint
STRIPE_PUBLISHABLE_KEY=               # pk_...; public identifier returned only to validated payment UI

# Québec taxable invoice configuration — required by the app before taxable LIVE invoices
GST_REGISTRATION_NUMBER=
QST_REGISTRATION_NUMBER=
STRIPE_TAX_RATE_GST_ID=               # Stripe Tax Rate configured at 5%
STRIPE_TAX_RATE_QST_ID=               # Stripe Tax Rate configured at 9.975%

# Admin / operations
ADMIN_EMAILS=
INTERAC_RECIPIENT_EMAIL=
INTERAC_RECIPIENT_NAME=Ocarina Spa
# Leave both blank when Interac Autodeposit is enabled
INTERAC_SECURITY_QUESTION=
INTERAC_SECURITY_ANSWER=

# Public destinations (server configuration; no client secret)
GOOGLE_REVIEW_URL=
FACEBOOK_PAGE_URL=

# Google Ads conversion action labels — public identifiers, only configure real actions
VITE_AW_LABEL_PHONE_CALL=
VITE_AW_LABEL_FORM_SUBMIT=
VITE_AW_LABEL_QUICK_SUBMISSION=
VITE_AW_LABEL_DIAGNOSTIC_LEAD=
VITE_AW_LABEL_INVOICE_PAY_CLICK=
VITE_AW_LABEL_INVOICE_PAID=
VITE_AW_LABEL_SURVEY_SUBMITTED=
VITE_AW_LABEL_REVIEW_CLICK=

# Internal hourly operations watchdog (generate a long random value)
AUTOMATION_CRON_SECRET=
STRIPE_GST_TAX_RATE_ID=               # alias accepté de STRIPE_TAX_RATE_GST_ID
STRIPE_QST_TAX_RATE_ID=               # alias accepté de STRIPE_TAX_RATE_QST_ID
RESEND_API_KEY=               # fournisseur courriel transactionnel
